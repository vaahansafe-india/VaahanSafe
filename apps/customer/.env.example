# Supabase Auth and server domain data
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_key

# Phone login is unavailable until both real MSG91 settings are supplied.
MSG91_AUTH_KEY=replace_with_msg91_server_key
MSG91_OTP_TEMPLATE_ID=replace_with_approved_otp_template_id
MSG91_WHATSAPP_OTP_WIDGET_ID=replace_with_whatsapp_primary_otp_widget_id

# Cloudflare monitoring and R2 remain configured separately.
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_API_TOKEN=replace_with_server_only_cloudflare_token
MSG91_WHATSAPP_NUMBER=918639785897
MSG91_WHATSAPP_NAMESPACE=28fc896d_7967_4778_9854_11a598207d4e
MSG91_WEBHOOK_SECRET=replace_with_random_server_only_secret_at_least_32_characters
NOTIFICATION_DISPATCH_SECRET=replace_with_independent_random_server_only_secret_at_least_32_characters
# Enable after migrations, callback configuration and scheduler checks pass.
NOTIFICATION_DISPATCH_ENABLED=false
OTP_REQUEST_HASH_SECRET=
CLOUDFLARE_R2_SCAN_REPORTS_BUCKET=vaahansafe-prod-private
CLOUDFLARE_SCAN_REPORTS_API_TOKEN=replace_with_existing_server_only_r2_token
DOCUMENT_VAULT_WORKER_URL=https://vaahansafe-document-vault.vaahansafe.workers.dev

