// QR relational data: Supabase. Cloudflare provides hosting, analytics and asset delivery.
// Set SUPABASE_SERVICE_ROLE_KEY with Wrangler secrets for each environment. Never put it in vars.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vaahansafe-qr",
  "main": ".worker-next/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SUPABASE_URL": "https://zpjwrptrqgpeyvlvscpv.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_b2gKJgEfWgdR99PqkQ5z2g_JOa7lfk4",
    "NEXT_PUBLIC_APP_ENV": "development"
  },
  "queues": {
    "producers": [
      {
        "binding": "ANALYTICS_QUEUE",
        "queue": "vaahansafe-dev-analytics-events"
      }
    ]
  },
  "env": {
    "development": {
      "queues": {
        "producers": [
          {
            "binding": "ANALYTICS_QUEUE",
            "queue": "vaahansafe-dev-analytics-events"
          }
        ]
      },
      "vars": {
        "SUPABASE_URL": "https://zpjwrptrqgpeyvlvscpv.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_b2gKJgEfWgdR99PqkQ5z2g_JOa7lfk4",
        "NEXT_PUBLIC_APP_ENV": "development"
      }
    },
    "staging": {
      "queues": {
        "producers": [
          {
            "binding": "ANALYTICS_QUEUE",
            "queue": "vaahansafe-staging-analytics-events"
          }
        ]
      },
      "vars": {
        "SUPABASE_URL": "https://zpjwrptrqgpeyvlvscpv.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_b2gKJgEfWgdR99PqkQ5z2g_JOa7lfk4",
        "NEXT_PUBLIC_APP_ENV": "staging"
      }
    },
    "production": {
      "queues": {
        "producers": [
          {
            "binding": "ANALYTICS_QUEUE",
            "queue": "vaahansafe-prod-analytics-events"
          }
        ]
      },
      "vars": {
        "SUPABASE_URL": "https://zpjwrptrqgpeyvlvscpv.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_b2gKJgEfWgdR99PqkQ5z2g_JOa7lfk4",
        "NEXT_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
