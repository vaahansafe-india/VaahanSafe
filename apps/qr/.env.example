# ==============================================================================
# VAAHANSAFE PUBLIC QR RESOLVER RUNTIME (.env.example)
# ==============================================================================

NODE_ENV=production
APP_ENV=production
APP_NAME=qr

NEXT_PUBLIC_WEB_URL=https://vaahansafe.com
NEXT_PUBLIC_APP_URL=https://app.vaahansafe.com
NEXT_PUBLIC_ACTIVATE_URL=https://activate.vaahansafe.com
NEXT_PUBLIC_QR_URL=https://qr.vaahansafe.com
NEXT_PUBLIC_STATUS_URL=https://status.vaahansafe.com
NEXT_PUBLIC_BLOG_URL=https://blog.vaahansafe.com
NEXT_PUBLIC_API_URL=https://api.vaahansafe.com
NEXT_PUBLIC_ADMIN_URL=https://admin.vaahansafe.com

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & AUTH
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# CLOUDFLARE INFRASTRUCTURE
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

