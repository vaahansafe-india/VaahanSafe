# Server-only status telemetry. Keep the Cloudflare token and Supabase key out of NEXT_PUBLIC_*.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public endpoints checked by the page. The Cloudflare Cron Worker uses the
# matching STATUS_* variables in its wrangler.toml.
STATUS_WEB_HEALTH_URL=https://www.vaahansafe.com/
STATUS_APP_HEALTH_URL=https://app.vaahansafe.com/api/auth/session
STATUS_ACTIVATE_HEALTH_URL=https://activate.vaahansafe.com/
STATUS_QR_HEALTH_URL=https://qr.vaahansafe.com/

# Configure these only after a dedicated production capability check exists.
# STATUS_PAYMENTS_HEALTH_URL=
# STATUS_NOTIFICATIONS_HEALTH_URL=
