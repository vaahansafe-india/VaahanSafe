{
  "name": "vaahansafe",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "description": "VaahanSafe — QR-based vehicle safety and emergency identification platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "npx turbo run dev --parallel",
    "dev:web": "npx turbo run dev --filter=@vaahansafe/web",
    "dev:app": "npx turbo run dev --filter=@vaahansafe/customer",
    "dev:activate": "npx turbo run dev --filter=@vaahansafe/activate",
    "dev:qr": "npx turbo run dev --filter=@vaahansafe/qr",
    "dev:admin": "npx turbo run dev --filter=@vaahansafe/admin",
    "dev:api": "npx turbo run dev --filter=@vaahansafe/api",
    "dev:blog": "npx turbo run dev --filter=@vaahansafe/blog",
    "dev:status": "npx turbo run dev --filter=@vaahansafe/status",
    "build": "node tooling/scripts/build-hostinger.mjs",
    "build:all": "node tooling/scripts/build-hostinger.mjs all",
    "build:web": "node tooling/scripts/build-hostinger.mjs web",
    "build:app": "node tooling/scripts/build-hostinger.mjs customer",
    "build:customer": "node tooling/scripts/build-hostinger.mjs customer",
    "build:activate": "npx turbo run build --filter=@vaahansafe/activate",
    "build:qr": "npx turbo run build --filter=@vaahansafe/qr",
    "build:admin": "npx turbo run build --filter=@vaahansafe/admin",
    "build:api": "npx turbo run build --filter=@vaahansafe/api",
    "build:blog": "npx turbo run build --filter=@vaahansafe/blog",
    "build:status": "npx turbo run build --filter=@vaahansafe/status",
    "start": "node server.js",
    "start:web": "node server.js",
    "lint": "npx turbo run lint",
    "typecheck": "npx turbo run typecheck",
    "test": "vitest run",
    "brand:assets": "node tooling/scripts/generate-brand-assets.mjs",
    "db:check": "npx tsx tooling/scripts/db-check.ts",
    "db:migrate:local": "node infrastructure/cloudflare/scripts/deploy-migrations.js dev",
    "db:migrate:remote": "node infrastructure/cloudflare/scripts/deploy-migrations.js prod --remote",
    "db:seed:dev": "npx tsx tooling/scripts/db-check.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "turbo run clean && rimraf node_modules .turbo"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turbo": "^2.10.13",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "eslint-config-next": "15.1.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.134.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
