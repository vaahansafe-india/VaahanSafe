# ==============================================================================
# VAAHANSAFE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Note: NEVER commit actual production secrets or place secrets in NEXT_PUBLIC_*
# ==============================================================================

# APP & RUNTIME
NODE_ENV=development
APP_ENV=development

# DOMAIN URLS (Local Development & Edge Routing)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_ACTIVATE_URL=http://localhost:3002
NEXT_PUBLIC_QR_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:3005
NEXT_PUBLIC_BLOG_URL=http://localhost:3006
NEXT_PUBLIC_STATUS_URL=http://localhost:3007

# AUTHENTICATION & SESSIONS
SESSION_SECRET=development_session_secret_at_least_32_characters_long
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# MSG91 (Transactional OTP & WhatsApp Alerts)
MSG91_AUTH_KEY=your_msg91_auth_key_placeholder
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id_placeholder
MSG91_WHATSAPP_NUMBER=919800000000

# CASHFREE PAYMENTS (India Gateway)
CASHFREE_CLIENT_ID=your_cashfree_app_id_placeholder
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key_placeholder
CASHFREE_ENV=TEST

# TRANSACTIONAL EMAIL
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=your_email_api_key_placeholder
EMAIL_FROM=support@vaahansafe.com

# BOT PROTECTION (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_placeholder
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_placeholder

# CLOUDFLARE BINDINGS (Production Workers/D1/R2/Queues are bound in wrangler.toml)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_placeholder
